# ── AI Dev MCP Server — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3001
BASE_URL=http://localhost:3001

# ── Auth: per-user API keys ─────────────────────────────────────────────────
# Format: "name:key,name:key,..."
# Each teammate gets their own key. Revoke one without affecting others.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
API_KEYS=alice:REPLACE_WITH_RANDOM_KEY_1,bob:REPLACE_WITH_RANDOM_KEY_2,charlie:REPLACE_WITH_RANDOM_KEY_3
#
# Legacy single-key format still works (treated as user "default"):
# API_KEY=your-secret-key-here

# ── IP allowlist (optional, strongest protection) ──────────────────────────
# Only these IPs can connect at all. Leave empty to rely on API key alone.
# Use your team's static IPs or Tailscale IP range.
#IP_ALLOWLIST=192.168.1.50,192.168.1.51,192.168.1.52

# ── Rate limiting ──────────────────────────────────────────────────────────
# Max /run requests per user per minute. Prevents GPU abuse if a key leaks.
RATE_LIMIT_PER_MIN=10

# ── LLM ──────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b

# ── Vector DB (ChromaDB) ──────────────────────────────────────────────────
# IMPORTANT: start ChromaDB bound to 127.0.0.1 only:
#   chroma run --host 127.0.0.1 --port 8000
# Anyone who can reach port 8000 directly bypasses all API key auth.
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Queue ───────────────────────────────────────────────────────────────────
JOB_TIMEOUT_MS=300000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── Security flags ─────────────────────────────────────────────────────
# Hides project names from MCP clients (Claude Desktop, Cursor, etc.)
EXPOSE_PROJECT_LIST=false

# ── Transport ────────────────────────────────────────────────────────────
# Uncomment for stdio mode (Claude Desktop direct connection):
# TRANSPORT=stdio
