# ── AI Dev MCP Server — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# Then just run: node src/index.js
#
# TRANSPORT is optional — defaults to http which runs BOTH use cases.
# Only set TRANSPORT=stdio if you want to connect a single local IDE
# directly to this process via stdin/stdout (no HTTP server).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
BASE_URL=http://localhost:3001

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to a long random string. All team members use the same key.
# Leave empty to disable auth (dev/local only — do not do this in production).
API_KEY=your-secret-key-here

# ── LLM ───────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b

# ── Vector DB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Queue ─────────────────────────────────────────────────────────────────────
# Max ms a single agent job can run before force-kill (default 5 minutes)
JOB_TIMEOUT_MS=300000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Transport (optional) ──────────────────────────────────────────────────────
# Uncomment ONLY if you want stdio mode instead of HTTP:
# TRANSPORT=stdio
