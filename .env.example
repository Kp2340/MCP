# AI Dev MCP Server — Environment Variables
# Copy this file to .env and fill in your values.

# Server
PORT=3001
BASE_URL=https://ai.decorom.in

# Auth: per-user API keys
# Format: "name:key,name:key,..."
# Each teammate gets their own key. Revoke one without affecting others.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=alice:REPLACE_WITH_RANDOM_KEY_1,bob:REPLACE_WITH_RANDOM_KEY_2
# Legacy single-key (treated as user "default"):
# API_KEY=your-secret-key-here

# IP allowlist (optional)
# If set, only these IPs can reach protected endpoints.
#IP_ALLOWLIST=192.168.1.50,192.168.1.51

# Rate limiting
RATE_LIMIT_PER_MIN=10

# LLM
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b

# Vector DB (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Queue
JOB_TIMEOUT_MS=300000

# CORS
CORS_ORIGIN=*

# =============================================================================
# SECURITY — Read carefully if your server is exposed to the internet
# =============================================================================

# Do NOT expose the known project list in error responses.
EXPOSE_PROJECT_LIST=false

# Controls whether remote callers can use project_register to add new projects.
#
# Option A — Maximum lockdown (no remote registration at all):
#   DISABLE_REMOTE_REGISTER=true
#   Add all projects manually to src/config/projects.json
#
# Option B — Allow registration, but only inside approved directories (recommended):
#   DISABLE_REMOTE_REGISTER=false
#   ALLOWED_ROOTS=C:/Users/kushp/IdeaProjects,C:/Users/kushp/Work
#   The server also checks that the path physically EXISTS on this machine,
#   so remote users can only register projects that are already on the server.
#
# NOTE: A remote user cannot register their local C:\Users\TheirName\... path.
# The path must exist on the server machine. If a teammate's project needs to
# be accessible, clone it to the server first and add it to projects.json.
DISABLE_REMOTE_REGISTER=false
ALLOWED_ROOTS=C:/Users/kushp/IdeaProjects,C:/Users/kushp/liferay-workspace,G:/

# Transport
# TRANSPORT=stdio
