# ─── AI Dev MCP Server — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# Windows: set variables in PowerShell with $env:VAR="value" or use a .env loader

# ── Transport ─────────────────────────────────────────────────────────────────
# "http"  → HTTP+SSE server (multi-IDE, production)
# "stdio" → Stdio transport (Claude Desktop direct)
TRANSPORT=http

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
BASE_URL=https://ai.decorom.in

# ── Auth ──────────────────────────────────────────────────────────────────────
# Change this to a long random string. Leave empty to disable auth (dev only).
API_KEY=your-secret-key-here

# ── LLM ───────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b

# ── Vector DB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Queue ─────────────────────────────────────────────────────────────────────
# Max ms a single agent job can run before force-kill (default 5 minutes)
JOB_TIMEOUT_MS=300000

# ── CORS ──────────────────────────────────────────────────────────────────────
# * = allow all origins. For production use your domain.
CORS_ORIGIN=*

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
